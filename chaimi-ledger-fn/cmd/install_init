#!/bin/bash

# install_init —— 安装应用文件前执行。只做依赖环境体检,不下载不落盘:
# 真机日志证实框架数据目录(@appdata/@apphome/@apptemp)此时尚未创建,安装期装依赖
# 只会落到 /tmp 兜底位,启动时还得在真正的基础目录重装一遍。依赖安装统一由
# cmd/main 的 ensure_site 在启动时完成(那时目录已就绪,装一次即到位)。
# 体检项:python3 + pip 可用(均来自应用中心 Python 运行时,manifest
# install_dep_apps=python312 保证装应用前运行时已就绪,官方运行时自带 pip)。
set -u

# Python 运行时来自应用中心依赖包（manifest install_dep_apps=python312）：
# fnOS 系统不保证自带 python3，统一前置运行时 bin 后再探测；系统 python3 存在时仅作回落
for _RT in /var/apps/python*/target/bin; do [ -d "$_RT" ] && PATH="$_RT:$PATH"; done
export PATH

TMPLOG="${TRIM_TEMP_LOGFILE:-/dev/stderr}"
log() {
    echo "install_init: $1" >&2
    echo "$(date '+%Y-%m-%d %H:%M:%S') - install_init: $1" >> "${TMPLOG}" 2>/dev/null
}

PY="$(command -v python3)"
[ -n "${PY}" ] || {
    log "未找到 python3（应用中心应已装 Python 运行时依赖，检查 /var/apps/python*/target/bin）"
    exit 1
}
"${PY}" -m pip --version >/dev/null 2>&1 || {
    log "pip 不可用（Python 运行时 ${PY} 应自带 pip，请重装应用中心的 Python 运行时依赖）"
    exit 1
}
log "环境体检通过: python3=${PY}, pip=$("${PY}" -m pip --version 2>/dev/null | awk '{print $1" "$2}')"
exit 0
