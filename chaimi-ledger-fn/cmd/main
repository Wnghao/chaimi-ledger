#!/bin/bash
#
# main —— chaimi-ledger 唯一生命周期控制器(start / stop / restart / status)。
# 管理 chaimi-server(FastAPI)：SQLite 数据在可写数据基目录，应用监听 Unix socket
# 由飞牛统一网关代理；均无 root。
# 路径全部经 TRIM_* 环境变量定位，选卷安装(/vol{n}/@app*)与系统分区安装通用；
# 唯一的历史包袱：root 时代安装的数据目录属主是 root、专用用户不可写——由
# pick_var_base 回落到可写目录、adopt_legacy 一次性接续旧数据/配置兜底。
# 退出码：0 成功/运行中，1 失败，3 status 未运行。
set -u

# Python 运行时来自应用中心依赖包（manifest install_dep_apps=python312）：
# fnOS 系统不保证自带 python3，统一前置运行时 bin 后再探测；系统 python3 仅作回落
for _RT in /var/apps/python*/target/bin; do [ -d "$_RT" ] && PATH="$_RT:$PATH"; done
export PATH

APP_DIR="${TRIM_APPDEST:-}"
GATEWAY_SOCKET="${APP_DIR}/app.sock"
APP_SRC="${APP_DIR}/src/server.py"
PY="$(command -v python3 || echo /usr/bin/python3)"

# 目录真实可写判定(探测文件法):mkdir 成功≠可写(属主/挂载限制),touch 成功才算
dir_writable() { (cd "$1" 2>/dev/null && touch .chaimi_probe 2>/dev/null && rm -f .chaimi_probe); }

# 可写数据基目录:PKGVAR(框架指定,启动时已创建且属主为专用用户)→PKGHOME→PKGTMP→/tmp 兜底
pick_var_base() {
    for _C in "${TRIM_PKGVAR:-}" "${TRIM_PKGHOME:-}" "${TRIM_PKGTMP:-}" "/tmp/chaimi-ledger"; do
        [ -n "${_C}" ] || continue
        mkdir -p "${_C}" 2>/dev/null
        dir_writable "${_C}" && { printf '%s' "${_C}"; return 0; }
    done
    return 1
}
VAR_BASE="$(pick_var_base || true)"
[ -n "${VAR_BASE}" ] || {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - main: 无可写数据目录(PKGVAR/PKGHOME/PKGTMP 均不可用)" \
        > "${TRIM_TEMP_LOGFILE:-/dev/stderr}" 2>/dev/null
    exit 1
}

LOG_FILE="${VAR_BASE}/info.log"
PID_FILE="${VAR_BASE}/chaimi.pid"
SITE="${VAR_BASE}/site-packages"

log_msg() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"; }

fail() {
    echo "$1" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    log_msg "$1"
    return 1
}

check_process() { [ -n "$1" ] && kill -0 "$1" 2>/dev/null; }

cleanup_socket() {
    if [ -e "${GATEWAY_SOCKET}" ]; then
        rm -f "${GATEWAY_SOCKET}"
        log_msg "已清理残留 socket ${GATEWAY_SOCKET}"
    fi
}

# root 时代安装兼容(仅基目录回落时触发,选卷安装全为 no-op):
# 旧数据/旧配置通常 644 可读,拷贝接续到基目录,新文件就位(存在)后不再重复拷;
# PKGETC 不可写时配置挪到基目录经 CHAIMI_CONF 指定,可写(框架正常准备)时不动
adopt_legacy() {
    if [ -n "${TRIM_PKGVAR:-}" ] && [ "${TRIM_PKGVAR}" != "${VAR_BASE}" ] && [ -d "${TRIM_PKGVAR}" ]; then
        for _F in chaimi.db chaimi.db-wal chaimi.db-shm; do
            if [ -r "${TRIM_PKGVAR}/${_F}" ] && [ ! -e "${VAR_BASE}/${_F}" ]; then
                cp -f "${TRIM_PKGVAR}/${_F}" "${VAR_BASE}/${_F}" 2>/dev/null \
                    && log_msg "已接续旧数据 ${_F}" \
                    || log_msg "警告:旧数据 ${_F} 接续失败(${TRIM_PKGVAR} → ${VAR_BASE})"
            fi
        done
        if [ -d "${TRIM_PKGVAR}/receipts" ] && [ ! -e "${VAR_BASE}/receipts" ]; then
            cp -rp "${TRIM_PKGVAR}/receipts" "${VAR_BASE}/receipts" 2>/dev/null \
                && log_msg "已接续旧票据目录 receipts/" \
                || log_msg "警告:旧票据目录 receipts/ 接续失败"
        fi
    fi
    if [ -n "${TRIM_PKGETC:-}" ] && ! dir_writable "${TRIM_PKGETC}"; then
        if [ -r "${TRIM_PKGETC}/chaimi.conf" ] && [ ! -e "${VAR_BASE}/chaimi.conf" ]; then
            cp -f "${TRIM_PKGETC}/chaimi.conf" "${VAR_BASE}/chaimi.conf" 2>/dev/null \
                && log_msg "已接续旧配置 chaimi.conf → ${VAR_BASE}"
        fi
        export CHAIMI_CONF="${VAR_BASE}/chaimi.conf"
        log_msg "TRIM_PKGETC 不可写,配置改用 ${CHAIMI_CONF}"
    fi
}

status_app() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        check_process "${pid}" && return 0
        rm -f "${PID_FILE}"
    fi
    return 1
}

# Python 依赖就位检查+安装(唯一安装点,install_init 只体检,避免装到安装期尚未
# 创建的数据目录)。哨兵 = requirements.txt 的 md5:首次启动或依赖清单变更才整包
# 重装——比逐包探测 import 目录更严,版本锁定变化也能触发(升级新增依赖靠重启自愈)
ensure_site() {
    REQ="${APP_DIR}/src/requirements.txt"
    [ -f "${REQ}" ] || { fail "缺少 ${REQ}"; return 1; }
    REQ_HASH="$(md5sum "${REQ}" 2>/dev/null | awk '{print $1}')"
    [ -n "${REQ_HASH}" ] && [ -f "${SITE}/.req-hash" ] \
        && [ "$(cat "${SITE}/.req-hash" 2>/dev/null)" = "${REQ_HASH}" ] && return 0

    log_msg "安装 Python 依赖到 ${SITE} ..."
    # 重装前清空:pip --target 叠装会残留旧版本 dist-info(先建目录再清,glob 永远有效)
    mkdir -p "${SITE}" 2>/dev/null
    rm -rf "${SITE}"/*
    # pip 用应用中心 Python 运行时自带的(官方运行时含 pip,真机验证 python312 带 pip 24.0)
    for IDX in "https://mirrors.ustc.edu.cn/pypi/simple" \
               "https://mirrors.aliyun.com/pypi/simple/" \
               "https://pypi.tuna.tsinghua.edu.cn/simple" \
               "https://pypi.org/simple"; do
        log_msg "使用 PyPI 源: ${IDX}"
        if python3 -m pip install --break-system-packages --no-compile --no-cache-dir \
            --timeout 15 --retries 2 --disable-pip-version-check \
            --index-url "${IDX}" --target "${SITE}" -r "${REQ}" >> "${LOG_FILE}" 2>&1; then
            printf '%s' "${REQ_HASH}" > "${SITE}/.req-hash" 2>/dev/null
            log_msg "Python 依赖安装完成(${IDX})"
            return 0
        fi
        log_msg "源 ${IDX} 失败,尝试下一个 ..."
    done
    fail "Python 依赖安装失败（网络？），详见 ${LOG_FILE}"
    return 1
}

start_app() {
    status_app && return 0
    [ -x "${PY}" ] && [ -f "${APP_SRC}" ] || { fail "python3(${PY}) 或 ${APP_SRC} 缺失"; return 1; }
    adopt_legacy
    ensure_site || return 1
    cleanup_socket
    log_msg "run user: $(id -un 2>/dev/null || echo '?') (TRIM_RUN_USERNAME=${TRIM_RUN_USERNAME:-<unset>}), 数据基目录: ${VAR_BASE}"
    log_msg "正在启动 chaimi-server ..."
    # TRIM_PKGVAR 传基目录(覆盖框架原值):server 侧 receipts/日志定位与 DB 对齐;
    # CHAIMI_DB 显式指定,不依赖 config.py 的 TRIM_PKGVAR 回退链
    TRIM_APPDEST="${APP_DIR}" \
    TRIM_PKGVAR="${VAR_BASE}" \
    CHAIMI_DB="${VAR_BASE}/chaimi.db" \
    TRIM_GATEWAY_SOCKET="app.sock" \
    TRIM_GATEWAY_PREFIX="/app/chaimi-ledger" \
    PYTHONPATH="${SITE}" \
        "${PY}" "${APP_SRC}" --uds "${GATEWAY_SOCKET}" >> "${LOG_FILE}" 2>&1 &
    SRV_PID=$!
    printf "%s" "${SRV_PID}" > "${PID_FILE}"
    log_msg "chaimi-server pid=${SRV_PID}"
    local i=0
    while [ ${i} -lt 30 ]; do
        [ -S "${GATEWAY_SOCKET}" ] && break
        sleep 1; i=$((i + 1))
    done
    if [ -S "${GATEWAY_SOCKET}" ]; then
        chmod 666 "${GATEWAY_SOCKET}"
        log_msg "网关 socket 就绪: ${GATEWAY_SOCKET} (/app/chaimi-ledger)"
    else
        fail "chaimi-server 未在 30 秒内就绪，详见 ${LOG_FILE}"
        return 1
    fi
}

stop_app() {
    if [ -r "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            kill -TERM "${pid}" 2>/dev/null
            local count=0
            while check_process "${pid}" && [ ${count} -lt 8 ]; do
                sleep 1; count=$((count + 1))
            done
            check_process "${pid}" && kill -KILL "${pid}" 2>/dev/null
        fi
        rm -f "${PID_FILE}"
    fi
    cleanup_socket
}

case "${1:-}" in
start)   start_app && exit 0; exit 1 ;;
stop)    stop_app; exit 0 ;;
restart) stop_app; start_app && exit 0; exit 1 ;;
status)  status_app && exit 0; exit 3 ;;
*)       fail "未知命令: ${1:-}"; exit 1 ;;
esac
